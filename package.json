{
  "name": "dsh-browser",
  "version": "0.1.0",
  "description": "不依赖 Chrome 调试协议驱动用户自己的 Google Chrome: 通过 native messaging 让扩展与 dsh 通信, 页面以带编号的文本交给模型, 保留真实 profile 与登录态.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.extension.json --noEmit",
    "icons": "python3 scripts/make-icons.py",
    "extension-id": "node scripts/extension-identity.mjs id extension/manifest.json",
    "test": "vitest run --pool=threads",
    "verify": "pnpm typecheck && pnpm build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/azazo1/dsh-browser"
  },
  "files": [
    "lib/*.js",
    "lib/*.cjs",
    "lib/*.d.ts",
    "assets/extension/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-browser-use": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-experimental-browser-use-runtime": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-browser-use": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-store": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-experimental-browser-use-runtime": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-util-values": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/chrome": "^0.0.254",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "external": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
